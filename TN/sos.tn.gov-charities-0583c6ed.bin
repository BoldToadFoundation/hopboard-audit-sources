        <div class="col-md-4 footer-tre-hargett">
                        <div class="region region-footer-hargett">
    <div id="block-footerabouttrehargett" class="block block-block-content block-block-content012fc7da-5e92-4a49-9d56-3391435e3383">
  
    
      
            <div class="clearfix text-formatted field field--name-body field--type-text-with-summary field--label-hidden field__item"><h3>Mission Statement</h3>
<p style="font-size: 1.8em;"><span>Our mission is to exceed the expectations of our customers, the taxpayers, by operating at the highest levels of accuracy, cost-effectiveness, and accountability in a customer-centered environment.</span></p>
<p>&nbsp;</p>
</div>
      
  </div>

