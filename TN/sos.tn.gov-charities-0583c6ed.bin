            <div class="clearfix text-formatted field field--name-body field--type-text-with-summary field--label-hidden field__item"><p><img alt="Tennessee's State Seal" class="tri-star-img" src="/themes/custom/sostngov_bootstrap4/images/state_seal.png"></p>
