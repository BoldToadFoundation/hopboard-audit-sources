    <div id="block-footertristarlogo" class="block block-block-content block-block-contente36e0380-8a7d-41e5-934b-b41624340d75">
  
    
      
            <div class="clearfix text-formatted field field--name-body field--type-text-with-summary field--label-hidden field__item"><p><img alt="Tennessee State's Tri-Star Logo" class="tri-star-img" src="/themes/custom/sostngov_bootstrap4/images/tri_star.png"></p>
</div>
      
  </div>

